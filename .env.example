# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Layering (see docs/configuration.md): real env vars > this file > the
# Reachy profile's .env (~/.hermes/profiles/reachy/.env, loaded if present).
# Shared secrets (OPENAI_API_KEY, MONGODB_URI, REACHY_VEC_ROBOT_HOST, ...) can
# live once in the profile .env — put only machine-specific overrides here.

# --- Secrets (no prefix; read by the SDKs directly) ---
OPENAI_API_KEY=sk-...
# Only needed for `reachy-vec sync-mongo`:
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/
# Only needed when REACHY_VEC_WEB_SEARCH=true (limited free credits):
# TAVILY_API_KEY=tvly-...

# --- Common overrides (full list: docs/configuration.md) ---
# REACHY_VEC_LLM_MODEL=gpt-5-mini
# REACHY_VEC_LLM_REASONING_EFFORT=minimal
# REACHY_VEC_STT_BACKEND=local          # local | openai (more accurate, ~1s slower)
# REACHY_VEC_STT_MODEL=base.en          # faster-whisper size for the local backend
# REACHY_VEC_FACE_THRESHOLD=0.45        # lower (e.g. 0.40) if known people show as unknown
# REACHY_VEC_CAMERA_INDEX=0             # Mac source only
# REACHY_VEC_MEDIA_SOURCE=auto          # auto | robot | mac (camera/mic/speaker location)
# REACHY_VEC_ROBOT_HOST=reachy-mini.local  # remote robot; unset = local daemon
# REACHY_VEC_ROBOT_PORT=8000
# REACHY_VEC_BARGE_IN=true              # talk over a reply to interrupt it
# REACHY_VEC_WEB_SEARCH=true            # enable the Tavily web_search tool (needs TAVILY_API_KEY)
# REACHY_VEC_WEATHER_LAT=53.4084        # lab location for get_weather (default: Liverpool, UK)
# REACHY_VEC_WEATHER_LON=-2.9916

# --- Voice-clone TTS (optional; default backend is macOS `say`) ---
# Record ~10s of clean speech first, e.g.:
#   sox -d -r 24000 -c 1 data/voice_sample.wav trim 0 10
# First qwen-tts run downloads the model from Hugging Face (~1.5 GB).
# REACHY_VEC_TTS_BACKEND=qwen-tts
# REACHY_VEC_VOICE_SAMPLE=data/voice_sample.wav
# Optional transcript of the sample; skips a one-off Whisper auto-transcription.
# REACHY_VEC_VOICE_SAMPLE_TEXT="exact words spoken in the sample"
# Clarity + loudness (clone output tracks the sample's dull, quiet level):
#   TARGET_RMS boosts the sustained body toward this level (soft-limited so it
#   never clips); PRESENCE_DB lifts highs above PRESENCE_HZ for intelligibility.
# REACHY_VEC_TTS_TARGET_RMS=0.16   # 0 disables; raise for louder
# REACHY_VEC_TTS_PRESENCE_DB=4.0   # 0 disables; raise for brighter/clearer
# REACHY_VEC_TTS_PRESENCE_HZ=3200

# --- Local LLM via oMLX (OpenAI-compatible; unset = OpenAI cloud) ---
# REACHY_VEC_LLM_BASE_URL=http://127.0.0.1:8001/v1
# REACHY_VEC_LLM_MODEL=Qwen3.8-27B-oQ4e-mtp
# REACHY_VEC_LLM_API_KEY=
